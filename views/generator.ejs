<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/app-logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FaastSaaS // Visual SaaS Architecture App Builder</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <style>
      .htmx-indicator {
        display: none;
      }
      .htmx-request .htmx-indicator {
        display: inline-block;
      }
    </style>
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen font-sans">
    <!-- <div
      class="max-w-2xl mx-auto bg-slate-900 border border-slate-800 p-8 rounded-2xl shadow-xl space-y-6 text-slate-200"
    > -->
    <div class="max-w-4xl mx-auto py-12 px-4">
      <!-- <div>
        <h2 class="text-2xl font-bold text-white">
          ⚡ FaastSaaS Boilerplate Generator
        </h2>
        <p class="text-slate-400 text-sm mt-1">
          Get your Express + HTMX stack and download your codebase.
        </p>
      </div> -->
      <header
        class="mb-12 border-b border-slate-800 pb-6 flex justify-between items-center"
      >
        <div>
          <h1
            class="text-2xl md:text-4xl font-black tracking-tight bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent"
          >
            ⚡faastsaas
          </h1>
          <p class="text-slate-400 mt-2 text-xs md:text-lg">
            Get your Express + HTMX stack and download your codebase.
          </p>
        </div>
        <div class="flex flex-col md:flex-row md:mx-auto">
          <a
            href="/index"
            class="bg-cyan-600/20 hover:bg-cyan-600/30 text-cyan-400 border border-cyan-500/30 px-4 py-2.5 m-2 rounded-xl font-semibold text-xs md:text-sm transition"
          >
            📈 AI Strategist →
          </a>
          <a
            href="/logout"
            class="bg-cyan-600/20 hover:bg-cyan-600/30 text-red-400 border border-cyan-500/30 p-2 text-center md:py-4 rounded-lg font-semibold text-xs md:text-sm transition"
          >
            Logout
          </a>
        </div>
      </header>
                <div class="flex justify-between items-center">
        <span class="text-slate-400">Current Plan:</span>
        <span class="font-bold text-emerald-400 uppercase"><%= user.planTier %></span>
    </div>
          <% if (user.planTier === 'free') { %>
        <div class="space-y-1 pt-2 border-t border-slate-700">
            <div class="flex justify-between text-slate-300 text-sm">
                <span>Available Boilerplates:</span>
                <span><%= user.saasGenerationsCount %> / 2</span>
            </div>
            <!-- <div class="flex justify-between text-slate-300">
                <span>Strategy Generations:</span>
                <span><%= user.saasGenerationsCount %> / 1</span>
            </div> -->
        </div>
        <a href="/pricing" class="block text-center m-3 bg-cyan-700 hover:bg-cyan-400 text-slate-200 py-1.5 rounded transition">
            Upgrade Plan
        </a>
    <% } %>

      <form action="/api/generate" method="POST" id="gen-form" onsubmit="triggerDownloadUI()" class="space-y-8">
        <!-- App Name Input -->
        <div>
          <label
            class="block text-xs font-semibold uppercase text-slate-400 mb-1"
            >Application Name</label
          >
          <input
            type="text"
            name="appName"
            required
            value="MyAwesomeSaaS"
            class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-emerald-500"
          />
        </div>

        <!-- Payment Engine Selection -->
        <div>
          <label
            class="block text-xs font-semibold uppercase text-slate-400 mb-1"
            >Billing / Payments Engine</label
          >
          <select
            name="paymentEngine"
            class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-emerald-500"
          >
            <option value="stripe">Stripe Checkout & Billing</option>
            <option value="lemonSqueezy">Lemon Squeezy</option>
            <option value="paddle">Paddle</option>
          </select>
        </div>

        <!-- Database Type Selection Toggle -->
        <div>
          <label
            class="block text-xs font-semibold uppercase text-slate-400 mb-2"
            >Database Provider Choice</label
          >
          <span class="text-sm text-slate-500 p-2">Don't forget to run `npm install` after you unzip your project.</span>
          <div class="grid grid-cols-2 gap-4">
            <label
              class="flex items-center gap-3 p-3 bg-slate-800 border border-slate-700 rounded-xl cursor-pointer hover:border-slate-600"
            >
              <input
                type="radio"
                name="dbType"
                value="mongodb"
                checked
                onclick="toggleDBFields('mongodb')"
                class="text-emerald-500 focus:ring-0"
              />
              <div>
                <div class="text-sm font-semibold text-white">
                  MongoDB Atlas
                </div>
                <div class="text-xs text-slate-400">
                  Document Store / Mongoose
                </div>
              </div>
            </label>

            <% if (user.planTier === 'pro') { %> 
            <label
              class="flex items-center gap-3 p-3 bg-slate-800 border border-slate-700 rounded-xl cursor-pointer hover:border-slate-600"
            >
              <input
                type="radio"
                name="dbType"
                value="supabase"
                onclick="toggleDBFields('supabase')"
                class="text-emerald-500 focus:ring-0"
              />
              <div>
                <div class="text-sm font-semibold text-white">Supabase</div>
                <div class="text-xs text-slate-400">
                  PostgreSQL / Supabase-JS
                </div>
              </div>
            </label>
            <% } %>
          </div>
        </div>

        <!-- Dynamic MongoDB Configuration Input -->
        <div id="mongo-fields" class="space-y-2">
          <label class="block text-xs font-semibold uppercase text-slate-400"
            >MongoDB Connection String</label
          >
          <input
            type="text"
            id="mongoUrl"
            name="mongoUrl"
            required
            placeholder="mongodb+srv://user:pass@cluster.mongodb.net/dbname"
            class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2.5 text-sm text-white font-mono focus:outline-none focus:border-emerald-500"
          />
        </div>

        <!-- Dynamic Supabase Configuration Inputs -->
        <div id="supabase-fields" class="space-y-4 hidden">
          <div>
            <label
              class="block text-xs font-semibold uppercase text-slate-400 mb-1"
              >Supabase Project URL</label
            >
            <input
              type="text"
              id="supabaseUrl"
              name="supabaseUrl"
              placeholder="https://your-project-id.supabase.co"
              class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2.5 text-sm text-white font-mono focus:outline-none focus:border-emerald-500"
            />
          </div>
          <div>
            <label
              class="block text-xs font-semibold uppercase text-slate-400 mb-1"
              >Supabase Anon / Service Key</label
            >
            <input
              type="password"
              id="supabaseKey"
              name="supabaseKey"
              placeholder="eyJhbGciOiJIUzI1NiIsInR..."
              class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2.5 text-sm text-white font-mono focus:outline-none focus:border-emerald-500"
            />
          </div>
        </div>

        <div class="pt-4 relative">
          <div
            id="status-toast"
            class="hidden mt-4 mb-2 p-4 bg-emerald-950/80 border border-emerald-500 rounded-lg text-center text-emerald-300 animate-pulse text-sm"
          >
            ✨ Packing authentication framework, database models, partial views,
            and subscription modules... Your download will begin instantly.
          </div>
          <!-- Submit Action -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-gradient-to-r from-green-700 to-green-500 hover:from-lime-600 hover:to-green-600 text-slate-950 font-bold shadow-xl tracking-wide transition transform active:scale-95 p-4 rounded-xl text-sm md:text-lg rounded-lg transition flex justify-center items-center gap-3"
          >
            <span id="btn-text">📦 Download Boilerplate (.zip)</span>
          </button>
        </div>
      </form>
    </div>

    <!--FOOTER-->
    <footer
      class="bottom-0 left-0 z-20 w-full p-4 bg-neutral-primary-soft border-t border-default shadow-sm md:flex md:items-center md:justify-between md:p-6"
    >
      <span class="text-sm text-body sm:text-center"
        >© 2026 FaastSaas by
        <a
          href="https://occiandiaali.com"
          target="_blank"
          class="underline text-emerald-400"
          >occiandiaali.com</a
        >
        | All Rights Reserved.</span
      >
      <ul
        class="flex flex-wrap items-center mt-3 text-sm font-medium text-body sm:mt-0"
      >
        <li><a href="#" class="hover:underline me-4 md:me-6">About</a></li>
        <li>
          <a href="/index" class="hover:underline me-4 md:me-6">Strategist</a>
        </li>
      </ul>
    </footer>

    <script>

      function toggleDBFields(dbType) {
        const mongoFields = document.getElementById("mongo-fields");
        const supabaseFields = document.getElementById("supabase-fields");

        const mongoInput = document.getElementById("mongoUrl");
        const supabaseUrl = document.getElementById("supabaseUrl");
        const supabaseKey = document.getElementById("supabaseKey");

        if (dbType === "mongodb") {
          // Show Mongo, hide Supabase
          mongoFields.classList.remove("hidden");
          supabaseFields.classList.add("hidden");

          // Set required on visible inputs only
          mongoInput.required = true;
          supabaseUrl.required = false;
          supabaseKey.required = false;
        } else {
          // Show Supabase, hide Mongo
          mongoFields.classList.add("hidden");
          supabaseFields.classList.remove("hidden");

          // Set required on visible inputs only
          mongoInput.required = false;
          supabaseUrl.required = true;
          supabaseKey.required = true;
        }
      }

      function triggerDownloadUI() {
        const btn = document.getElementById("submit-btn");
        const text = document.getElementById("btn-text");
        const toast = document.getElementById("status-toast");

        btn.disabled = true;
        btn.style.opacity = "0.5";
        btn.style.cursor = "not-allowed";
        text.innerHTML =
          "⚙️ Executing Full-Stack App Scaffolding Compilation...";
        toast.classList.remove("hidden");

        setTimeout(() => {
          btn.disabled = false;
          btn.style.opacity = "1";
          btn.style.cursor = "pointer";
          text.innerHTML =
            "📦 Generate & Download Full SaaS Boilerplate Source (.zip)";
          toast.classList.add("hidden");
        }, 5000);
      }
    </script>
  </body>
</html>
