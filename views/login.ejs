<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/app-logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In // FaastSaaS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <style>
      .htmx-indicator {
        display: none !important;
      }
      .htmx-request .htmx-indicator,
      .htmx-request.htmx-indicator {
        display: inline-flex !important;
      }
    </style>
  </head>
  <body
    class="bg-slate-900 text-slate-100 flex items-center justify-center min-h-screen p-4"
  >
    <div
      class="w-full max-w-md bg-slate-800/60 p-8 rounded-xl border border-slate-700 shadow-xl"
    >
      <!-- Navigation / Back Button -->
      <div
        class="mb-6 flex justify-between items-center border-b border-slate-700/60 pb-4"
      >
        <a
          href="/"
          class="text-xs bg-slate-700/60 hover:bg-slate-700 px-3 py-1.5 rounded-lg text-slate-300 border border-slate-600 transition flex items-center gap-1"
        >
          ← Back to Home
        </a>
        <span
          class="text-xs font-semibold text-cyan-400 uppercase tracking-wide"
          >Account Access</span
        >
      </div>

      <h2 class="text-2xl font-bold mb-2 text-center text-cyan-400">
        Sign in to ⚡faastsaas
      </h2>
      <p class="text-xs text-slate-400 text-center mb-6">
        Welcome back! Manage your verified domains and strategies.
      </p>

      <!-- HTMX Target Container for Inline Error Alerts -->
      <div id="auth-error-target"></div>

      <!-- HTMX Login Form -->
      <form
        hx-post="/api/auth/login"
        hx-target="#auth-error-target"
        hx-indicator="#auth-spinner"
        class="space-y-4"
      >
        <div>
          <label class="block text-sm text-slate-300 mb-1 font-medium"
            >Email Address</label
          >
          <input
            type="email"
            name="email"
            required
            placeholder="founder@saas.com"
            class="w-full p-3 rounded bg-slate-700/80 border border-slate-600 text-white text-sm focus:outline-cyan-400"
          />
        </div>

        <div>
          <label class="block text-sm text-slate-300 mb-1 font-medium"
            >Password</label
          >
          <input
            type="password"
            name="password"
            required
            placeholder="••••••••"
            class="w-full p-3 rounded bg-slate-700/80 border border-slate-600 text-white text-sm focus:outline-cyan-400"
          />
        </div>

        <button
          type="submit"
          class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold p-3 rounded-lg transition shadow-md flex items-center justify-center gap-2"
        >
          <span>Sign In</span>
          <!-- Loading Spinner -->
          <svg
            id="auth-spinner"
            class="animate-spin h-4 w-4 text-slate-950 htmx-indicator"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
            ></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            ></path>
          </svg>
        </button>
      </form>

      <p class="text-xs text-slate-400 text-center mt-6">
        Don't have an account?
        <a
          href="/register"
          class="text-emerald-400 hover:underline font-semibold"
          >Register</a
        >
      </p>
    </div>
  </body>
</html>
