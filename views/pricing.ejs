<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/app-logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Subscription Plans // FaastSaaS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen py-12 px-4">
    <div class="max-w-5xl mx-auto mb-4 text-center space-y-12">
      <!-- Navigation / Back Button -->
      <div
        class="mb-6 flex justify-between items-center border-b border-slate-700/60 pb-4"
      >
        <a
          href="/"
          class="text-xs bg-slate-700/60 hover:bg-slate-700 px-3 py-1.5 rounded-lg text-slate-300 border border-slate-600 transition flex items-center gap-1"
        >
          ← Back to Home
        </a>
      </div>

      <h1 class="text-4xl font-extrabold text-cyan-400">
        Straightforward Subscription
      </h1>

      <div class="grid md:grid-cols-3 gap-8 text-left">
        <!-- Free -->
        <div
          class="bg-slate-800 p-6 rounded-xl border border-slate-700 flex flex-col justify-between"
        >
          <div>
            <h3 class="text-xl font-bold mb-2">Free</h3>
            <p class="text-3xl font-extrabold mb-4">
              $0 <span class="text-sm font-normal text-slate-400">/mo</span>
            </p>
            <ul class="text-sm space-y-2 text-slate-300 mb-6">
              <li>✓ Generate 1 SaaS Boilerplate</li>
              <li>✓ Scan 1 Verified Domain</li>
              <li>✓ Minimal Marketing Guidance</li>
              <li>X No Export PDF & TXT</li>
            </ul>
          </div>

          <form action="/payments/checkout" method="POST">
            <input type="hidden" name="plan" value="free" />
            <button
              type="submit"
              class="w-full bg-slate-700 hover:bg-slate-600 font-bold py-2 rounded"
            >
              Try Free
            </button>
          </form>
        </div>
        <!-- Pro -->
        <div
          class="bg-slate-800 p-6 rounded-xl border-2 border-cyan-400 flex flex-col justify-between relative"
        >
          <span
            class="absolute -top-3 right-4 bg-cyan-400 text-slate-950 text-xs font-bold px-2 py-0.5 rounded"
            >Popular</span
          >
          <div>
            <h3 class="text-xl font-bold mb-2 text-cyan-400">Starter</h3>
            <p class="text-3xl font-extrabold mb-4">
              $19 <span class="text-sm font-normal text-slate-400">/mo</span>
            </p>
            <ul class="text-sm space-y-2 text-slate-300 mb-6">
              <li>✓ Up to 6 Verified Domains Scanned</li>
              <li>✓ Generate up to 6 SaaS Boilerplates</li>
              <li>✓ Full Guidance Roadmaps</li>
              <li>✓ Export PDF & TXT</li>
            </ul>
          </div>

          <form action="/payments/checkout" method="POST">
            <input type="hidden" name="plan" value="starter" />
            <button
              type="submit"
              class="w-full bg-emerald-400 text-slate-900 font-bold py-2 rounded hover:bg-emerald-300"
            >
              Choose Starter
            </button>
          </form>
        </div>
        <!-- Enterprise -->
        <div
          class="bg-slate-800 p-6 rounded-xl border border-slate-700 flex flex-col justify-between"
        >
          <div>
            <h3 class="text-xl font-bold mb-2">Pro</h3>
            <p class="text-3xl font-extrabold mb-4">
              $89
              <span class="text-sm font-normal text-slate-400"> /mo</span>
            </p>
            <ul class="text-sm space-y-2 text-slate-300 mb-6">
              <li>✓ Generate Unlimited Boilerplates</li>
              <li>✓ Unlimited Verified Domains</li>
              <li>✓ NextJS Core Engine option</li>
              <li>✓ Additional DB options</li>
            </ul>
          </div>

          <form action="/payments/checkout" method="POST">
            <input type="hidden" name="plan" value="pro" />
            <button
              type="submit"
              class="w-full bg-slate-700 hover:bg-slate-600 font-bold py-2 rounded"
            >
              Upgrade to Pro
            </button>
          </form>
        </div>
      </div>
    </div>
    <!--
    Testing Locally
When developing on localhost, Stripe can't reach your /api/webhooks/stripe endpoint directly. Use the official Stripe CLI to forward webhook events:

stripe listen --forward-to localhost:3000/api/webhooks/stripe

It will print a secret like whsec_... — copy that directly into your .env file as STRIPE_WEBHOOK_SECRET!
    -->

    <!--FOOTER-->
    <footer
      class="bottom-0 left-0 z-20 w-full p-2 bg-neutral-primary-soft border-t border-default shadow-sm md:flex md:items-center md:justify-between md:p-4"
    >
      <span class="text-sm text-body sm:text-center"
        >© 2026 FaastSaas by
        <a
          href="https://occiandiaali.com"
          target="_blank"
          class="underline text-emerald-400"
          >occiandiaali.com</a
        >
        | All Rights Reserved.</span
      >
    </footer>
  </body>
</html>
