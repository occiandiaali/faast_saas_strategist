<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/app-logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FaastSaaS // Ship Your SaaS Marketing Faster</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen">
    <div class="max-w-6xl mx-auto px-6 py-8">
      <header class="flex justify-between items-center mb-16">
        <h1
          class="text-2xl md:text-4xl font-black bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent"
        >
          ⚡FaastSaaS
        </h1>
        <div class="flex flex-col md:flex-row gap-4 items-center">
          <a
            href="/pricing"
            class="text-xs md:text-sm text-slate-300 hover:text-white"
            >Pricing</a
          >
          <a
            href="/login"
            class="text-xs md:text-sm text-slate-300 hover:text-white"
            >Sign In</a
          >

          <a
            href="/register"
            class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 px-4 py-2 rounded-lg text-xs md:text-sm font-bold transition"
            >Get Started</a
          >
        </div>
      </header>

      <section class="text-center my-20 max-w-3xl mx-auto space-y-6">
        <span
          class="bg-cyan-950 text-cyan-400 text-xs font-semibold px-3 py-1.5 rounded-full border border-cyan-800"
          >AI Growth Intelligence</span
        >
        <h2
          class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight"
        >
          Verified SaaS Crawling & Go-To-Market Plans
        </h2>
        <p class="text-slate-400 text-lg">
          Verify domain ownership, crawl landing pages securely, and generate
          actionable marketing roadmaps powered by Gemini AI.
        </p>
        <div class="flex gap-4 justify-center pt-4">
          <a
            href="/register"
            class="bg-gradient-to-r from-emerald-400 to-cyan-400 text-slate-950 px-2 md:px-8 py-3 rounded-lg font-bold text-md md:text-lg hover:opacity-90 transition"
            >Start Free</a
          >
          <a
            href="/pricing"
            class="bg-slate-800 border border-slate-700 px-2 md:px-8 py-3 rounded-lg font-bold text-md md:text-lg hover:bg-slate-700 transition"
            >View Plans</a
          >
        </div>
      </section>
    </div>
    <!--FOOTER-->
    <footer
      class="bottom-0 left-0 z-20 w-full p-4 bg-neutral-primary-soft border-t border-default shadow-sm md:flex md:items-center md:justify-between md:p-6"
    >
      <span class="text-sm text-body sm:text-center"
        >© 2026 FaastSaas by
        <a
          href="https://occiandiaali.com"
          target="_blank"
          class="underline text-emerald-400"
          >occiandiaali.com</a
        >
        | All Rights Reserved.</span
      >
      <!-- <ul
        class="flex flex-wrap items-center mt-3 text-sm font-medium text-body sm:mt-0"
      >
        <li>
          <a href="#" class="hover:underline me-4 md:me-6">About</a>
        </li>
        <li>
          <a href="/generator " class="hover:underline me-4 md:me-6">SaaS</a>
        </li>
      </ul> -->
    </footer>
  </body>
</html>
